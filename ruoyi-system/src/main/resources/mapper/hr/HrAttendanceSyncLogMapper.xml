<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.hr.HrAttendanceSyncLogMapper">
    <resultMap type="HrAttendanceSyncLog" id="HrAttendanceSyncLogResult">
        <id property="logId" column="log_id"/>
        <result property="batchNo" column="batch_no"/>
        <result property="triggerType" column="trigger_type"/>
        <result property="sourceType" column="source_type"/>
        <result property="status" column="status"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="totalCount" column="total_count"/>
        <result property="successCount" column="success_count"/>
        <result property="failCount" column="fail_count"/>
        <result property="message" column="message"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <insert id="insertHrAttendanceSyncLog" parameterType="HrAttendanceSyncLog" useGeneratedKeys="true" keyProperty="logId">
        insert into hr_attendance_sync_log(
            batch_no, trigger_type, source_type, status, start_time, end_time,
            total_count, success_count, fail_count, message, create_by, create_time
        )
        values(
            #{batchNo}, #{triggerType}, #{sourceType}, #{status}, #{startTime}, #{endTime},
            #{totalCount}, #{successCount}, #{failCount}, #{message}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateHrAttendanceSyncLog" parameterType="HrAttendanceSyncLog">
        update hr_attendance_sync_log
        <set>
            <if test="triggerType != null">trigger_type = #{triggerType},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="totalCount != null">total_count = #{totalCount},</if>
            <if test="successCount != null">success_count = #{successCount},</if>
            <if test="failCount != null">fail_count = #{failCount},</if>
            <if test="message != null">message = #{message},</if>
            update_by = #{updateBy},
            update_time = sysdate()
        </set>
        where log_id = #{logId}
    </update>

    <select id="selectHrAttendanceSyncLogList" parameterType="HrAttendanceSyncLog" resultMap="HrAttendanceSyncLogResult">
        select *
        from hr_attendance_sync_log
        <where>
            1 = 1
            <if test="batchNo != null and batchNo != ''">and batch_no like concat('%', #{batchNo}, '%')</if>
            <if test="triggerType != null and triggerType != ''">and trigger_type = #{triggerType}</if>
            <if test="sourceType != null and sourceType != ''">and source_type = #{sourceType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by log_id desc
    </select>
</mapper>
